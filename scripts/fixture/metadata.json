{
  "version": 3,
  "sources": [
    {
      "name": "default",
      "kind": "postgres",
      "tables": [
        {
          "table": {
            "name": "patient_consent",
            "schema": "public"
          },
          "computed_fields": [
            {
              "name": "is_active",
              "definition": {
                "function": {
                  "name": "consent_is_active",
                  "schema": "public"
                }
              }
            }
          ],
          "select_permissions": [
            {
              "role": "patient",
              "permission": {
                "columns": ["id", "patient_id", "granted_at"],
                "filter": {
                  "patient_id": {
                    "_eq": "X-Hasura-User-Id"
                  }
                },
                "limit": 100
              }
            }
          ],
          "event_triggers": [
            {
              "name": "on_consent_created",
              "definition": {
                "enable_manual": false,
                "insert": {
                  "columns": "*"
                }
              },
              "retry_conf": {
                "interval_sec": 5,
                "num_retries": 1,
                "timeout_sec": 5
              },
              "webhook": "http://example.invalid/hook"
            }
          ]
        }
      ],
      "configuration": {
        "connection_info": {
          "database_url": {
            "from_env": "HASURA_GRAPHQL_DATABASE_URL"
          }
        }
      }
    }
  ],
  "remote_schemas": [
    {
      "name": "self_remote",
      "definition": {
        "url": "__SELF_URL__",
        "timeout_seconds": 30,
        "customization": {
          "root_fields_namespace": "remote",
          "type_names": {
            "mapping": {},
            "prefix": "rmt_"
          }
        },
        "headers": [
          {
            "name": "x-hasura-admin-secret",
            "value": "fixture"
          }
        ]
      }
    }
  ],
  "actions": [
    {
      "name": "revokeConsent",
      "definition": {
        "handler": "http://example.invalid/revoke",
        "output_type": "RevokeConsentOutput!",
        "forward_client_headers": true,
        "arguments": [
          {
            "name": "input",
            "type": "RevokeConsentInput!"
          }
        ],
        "type": "mutation",
        "kind": "synchronous"
      },
      "comment": "Revoke a consent and notify downstream",
      "permissions": [
        {
          "role": "patient"
        }
      ]
    }
  ],
  "custom_types": {
    "input_objects": [
      {
        "name": "RevokeConsentInput",
        "fields": [
          {
            "name": "consentId",
            "type": "uuid!"
          },
          {
            "name": "reason",
            "type": "String"
          }
        ]
      }
    ],
    "objects": [
      {
        "name": "RevokeConsentOutput",
        "fields": [
          {
            "name": "ok",
            "type": "Boolean!"
          },
          {
            "name": "revokedAt",
            "type": "timestamptz"
          }
        ]
      }
    ]
  },
  "cron_triggers": [
    {
      "name": "nightly_consent_audit",
      "webhook": "http://example.invalid/audit",
      "schedule": "0 2 * * *",
      "include_in_metadata": true
    }
  ]
}
